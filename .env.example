# Copy to .env (gitignored) for local overrides; the `dev` profile loads it.
# In deployed environments set these as real environment variables instead.

# Database
DB_URL=jdbc:postgresql://localhost:5432/learning_platform
DB_USERNAME=learning_platform
DB_PASSWORD=learning_platform

# JWT signing key: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# JWT_ISSUER=learning-platform
# JWT_ACCESS_TOKEN_TTL=15m

# Frontend origin(s), comma-separated, exact, no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Refresh-token cookie / session settings
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=Lax
# AUTH_COOKIE_PATH=/api/auth
# AUTH_COOKIE_DOMAIN=
# AUTH_REFRESH_TOKEN_TTL=1d
# AUTH_REMEMBER_ME_REFRESH_TOKEN_TTL=30d
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOGIN_LOCK_DURATION=15m
